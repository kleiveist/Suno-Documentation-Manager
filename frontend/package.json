  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run performance:check",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "performance:check": "node scripts/check-bundle-budget.mjs",
